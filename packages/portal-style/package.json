{
  "name": "@deskpro/portal-style",
  "version": "1.3.0-alpha.0",
  "description": "Styling for for Deskpro Portal Interface",
  "author": "DeskPRO <support@deskpro.com>",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/style.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn css",
    "css-compile": "sass --style compressed --source-map --embed-sources --no-error-css --load-path=node_modules src/:dist/",
    "css-lint": "stylelint src/",
    "css-prefix": "postcss --replace dist/**/*.css --use autoprefixer --map",
    "css": "yarn css-compile && yarn css-prefix"
  },
  "dependencies": {
    "bootstrap": "5.2.3"
  },
  "devDependencies": {
    "globals": "^15.13.0",
    "postcss": "^8.0.0",
    "postcss-cli": "^11.0.0",
    "sass": "1.77.6",
    "stylelint": "^16.11.0",
    "stylelint-config-twbs-bootstrap": "^15.1.0",
    "stylelint-scss": "^6.10.0"
  }
}
